# ================================================================
#  VPay Backend — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env — it is in .gitignore.
# ================================================================


# ── Server ──────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=3000

# "development" → verbose logs, stack traces in error responses
# "production"  → concise logs, no stack traces exposed to clients
NODE_ENV=development


# ── Supabase ────────────────────────────────────────────────────
# Find all three values in:
#   Supabase Dashboard → Project Settings → API

# Your project's REST URL  (looks like: https://abcxyz.supabase.co)
SUPABASE_URL=https://ggftltcgbpdvtnjjfcuk.supabase.co

# Service Role key — has full DB access, bypasses Row Level Security.
# Keep this secret. Only use it on the server, never in the app.
# Get from: Settings → API Keys → Legacy anon, service_role API keys → service_role → Reveal
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NOTE: SUPABASE_JWT_SECRET is no longer needed.
# Token verification is handled by supabase.auth.getUser() which works
# with any signing algorithm (HS256, ECC P-256, etc.)


# ── OpenAI (Whisper) ────────────────────────────────────────────
# Used for audio → text transcription.
# Get your key at: https://platform.openai.com/api-keys
# Model used: whisper-1
# Cost: ~$0.006 per minute of audio
OPENAI_API_KEY=sk-proj-...


# ── OpenRouter (Mistral AI) ─────────────────────────────────────
# Used for intent parsing (make_payment / check_balance / etc.)
# Get your key at: https://openrouter.ai/keys
# Model used: mistralai/mistral-small-3.1-24b-instruct:free  (free tier)
OPENROUTER_API_KEY=sk-or-v1-...


# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API.
# For local dev with Expo Go, add your machine's LAN IP on port 8081.
# Find your LAN IP on Windows: run  ipconfig  → look for IPv4 Address
# For production: replace with your actual deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:3000,exp://192.168.1.5:8081,http://192.168.1.5:8081
