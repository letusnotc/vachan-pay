# ================================================================
#  VPay Backend — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env — it is in .gitignore.
# ================================================================


# ── Server ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development


# ── Supabase ────────────────────────────────────────────────────
# Find both values in: Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # service_role key (NOT anon key)


# ── Groq (Whisper ASR) ──────────────────────────────────────────
# Get free key at: https://console.groq.com/keys
# Model: whisper-large-v3  (free tier: 2000 req/day, no data training)
GROQ_API_KEY=gsk_...


# ── Google AI (Gemma 4) ─────────────────────────────────────────
# Get free key at: https://aistudio.google.com/apikey
# Model: gemma-4-26b-a4b-it
GEMINI_API_KEY=AIza...


# ── CORS ────────────────────────────────────────────────────────
# Your machine's LAN IP — run ipconfig → IPv4 under Wi-Fi adapter
ALLOWED_ORIGINS=http://localhost:3000,exp://<your-LAN-IP>:8081,http://<your-LAN-IP>:8081
