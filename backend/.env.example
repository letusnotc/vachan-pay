# ================================================================
#  VPay Backend — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env — it is in .gitignore.
# ================================================================


# ── Server ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development


# ── Supabase ────────────────────────────────────────────────────
# Find both values in: Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://<your-project-ref>.supabase.co

# Service Role key — full DB access, bypasses RLS. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...


# ── Groq (Whisper ASR) ──────────────────────────────────────────
# https://console.groq.com/keys  |  Model: whisper-large-v3  (free: 2000 req/day)
GROQ_API_KEY=gsk_...


# ── Google AI (Gemma 4) ─────────────────────────────────────────
# https://aistudio.google.com/apikey  |  Model: gemma-4-26b-a4b-it
GEMINI_API_KEY=AIza...


# ── CORS ────────────────────────────────────────────────────────
# Comma-separated origins. For local dev add your machine's LAN IP on port 8081.
ALLOWED_ORIGINS=http://localhost:3000,exp://<your-LAN-IP>:8081,http://<your-LAN-IP>:8081


# ── Stripe ──────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
# Use TEST keys (sk_test_...) for development, LIVE keys (sk_live_...) for production.
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — get from Stripe Dashboard → Webhooks → your endpoint → Signing secret
# For local dev use: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Your Stripe publishable key — this goes in the FRONTEND .env (EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY)
# Listed here for reference only — never set it on the backend.
# STRIPE_PUBLISHABLE_KEY=pk_test_...


# ── Request signing (Network Security Layer 4) ───────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match vpay-rn/.env's EXPO_PUBLIC_APP_SIGNING_SECRET exactly.
APP_SIGNING_SECRET=
