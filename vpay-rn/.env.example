# ================================================================
#  VPay React Native App — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env — it is in .gitignore.
#
#  All variables MUST start with EXPO_PUBLIC_ so Expo bundles
#  them into the JavaScript at build time.
# ================================================================


# ── Supabase ────────────────────────────────────────────────────
# Find both values in: Supabase Dashboard → Project Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...   # anon/public key (safe for client)


# ── Backend API ─────────────────────────────────────────────────
# Use your machine's LAN IP — NOT localhost (phone can't reach that).
# Find it on Windows: ipconfig → IPv4 Address under Wi-Fi adapter
# Example: http://192.168.1.42:3000/api
EXPO_PUBLIC_API_URL=http://<your-LAN-IP>:3000/api


# ── Stripe ──────────────────────────────────────────────────────
# Stripe Dashboard → Developers → API keys → Publishable key
# Use the TEST key (pk_test_...) for development.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...


# ── Request signing (Network Security Layer 4) ───────────────────────────────
# Must match backend/.env's APP_SIGNING_SECRET exactly.
EXPO_PUBLIC_APP_SIGNING_SECRET=
