# ================================================================
#  VPay React Native App — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env — it is in .gitignore.
#
#  All variables MUST start with EXPO_PUBLIC_ so Expo bundles
#  them into the JavaScript at build time.
# ================================================================


# ── Supabase ────────────────────────────────────────────────────
# Find both values in:
#   Supabase Dashboard → Project Settings → API

# Your project's REST URL  (looks like: https://abcxyz.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://ggftltcgbpdvtnjjfcuk.supabase.co

# Anon / public key — safe to use in the app (RLS protects the data).
# This is NOT the service role key — that one stays on the server only.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── Backend API ─────────────────────────────────────────────────
# The base URL your Express backend is reachable at from the phone.
#
# LOCAL DEV (Expo Go on a physical phone on the same Wi-Fi):
#   Use your machine's LAN IP — NOT localhost (the phone can't reach that).
#   Find it on Windows:  ipconfig  → IPv4 Address under your Wi-Fi adapter
#   Example: http://192.168.1.42:3000/api
#
# PRODUCTION:
#   Use your deployed HTTPS URL, e.g. https://vpay-api.railway.app/api
#
EXPO_PUBLIC_API_URL=http://192.168.1.5:3000/api
