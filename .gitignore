# ================================================================
#  VPay — Root .gitignore
#  Covers: Node.js/Express, React Native/Expo, Python, ML models
# ================================================================


# ── Excluded folders (not part of this repo) ────────────────────
mobile_app/
.claude/

# ── Excluded root files ──────────────────────────────────────────
REVIEW.md


# ── Environment (NEVER commit secrets) ──────────────────────────
.env
.env.local
.env.production
.env.staging
.env.development
*.env


# ── Node.js / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock


# ── Expo / React Native ─────────────────────────────────────────
.expo/
dist/
web-build/
android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
expo-env.d.ts


# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.virtualenv/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# mypy / pyright / ruff
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/


# ── Machine Learning / Audio ─────────────────────────────────────
# Uncomment if you don't want to commit large model files:
# *.h5
# *.pb
# saved_model/
# voice_auth_model_cnn/

# Temporary audio files
temp.wav
temp_*.wav
*.tmp


# ── Logs ────────────────────────────────────────────────────────
logs/
*.log


# ── Build output ────────────────────────────────────────────────
out/
.next/
.nuxt/
.cache/
.parcel-cache/


# ── OS junk ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini


# ── Editor ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
